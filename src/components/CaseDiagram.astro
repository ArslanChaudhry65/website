---
interface Props { kind: 'enrolment' | 'migration'; compact?: boolean; }
const { kind, compact = false } = Astro.props;
const models = {
 enrolment: { label: 'Enrolment architecture', title: 'Separate the work. Protect the transaction.', stages: [['Enrolment request','Validate once'],['Batch processing','Commit enrolments'],['Event delivery','Send notifications']], caption:'Conceptual flow. Separating notification delivery removes SMTP from the enrolment transaction.'},
 migration: { label: 'Migration approach', title: 'One product. Two paths. A deliberate switch.', stages: [['Existing entry point','Resolve deep links'],['Client configuration','Choose the active editor'],['Legacy or new editor','Preserve access rules']], caption:'Conceptual routing. Each client can adopt the new editor without a system-wide cutover.'}
};
const model = models[kind];
---
<figure class:list={['decision-diagram', {compact}]}>
  <p class="eyebrow">{model.label}</p>
  {!compact && <p class="diagram-title">{model.title}</p>}
  <ol class="diagram-stages">
    {model.stages.map(([title, detail], i) => <li><span class="stage-number">0{i+1}</span><span class="stage-title">{title}</span><span class="stage-detail">{detail}</span></li>)}
  </ol>
  {!compact && <figcaption>{model.caption}</figcaption>}
</figure>
