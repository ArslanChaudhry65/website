---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Imprint" noindex><div class="shell"><header class="page-heading"><p class="eyebrow">Site information</p><h1>Imprint</h1></header><div class="prose legal-copy"><p>{site.legal.name}</p>{site.legal.address ? <p class="preserve-lines">{site.legal.address}<br/>{site.legal.country}</p> : <p>Local preview. The publisher's service address must be completed before this site is published.</p>}<p>Contact: <a href={'mailto:'+site.email}>{site.email}</a></p><p>This is a personal website. It does not represent the views of the employers mentioned in the case studies.</p></div></div></BaseLayout>
