---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact" section="Contact" description="Get in touch with Arslan Chaudhry about senior product roles, enterprise software and AI product decisions.">
  <div class="shell"><header class="page-heading"><p class="eyebrow">Contact</p><h1>What makes your<br />product difficult?</h1><p class="lead">I am interested in Senior Product Owner and Product Manager roles in B2B SaaS, remote or Berlin-based. I also welcome thoughtful conversations about enterprise platforms and AI products.</p></header>
  <div class="contact-panel"><p>A little context helps: the product, the problem and the responsibility you have in mind.</p><div class="actions"><a class="button button-primary" href={'mailto:'+site.email}>Email me <Arrow direction="up"/></a><a class="text-link" href={site.linkedin}>Connect on LinkedIn <Arrow direction="up"/></a></div><p class="contact-address">{site.email}</p></div></div>
</BaseLayout>
