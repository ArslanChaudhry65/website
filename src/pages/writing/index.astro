---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
const articles = (await getCollection('writing')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Writing" section="Writing" description="Essays on reversible migrations, enterprise constraints and AI product economics, grounded in product work.">
<div class="shell"><header class="page-heading"><p class="eyebrow">Writing</p><h1>Arguments from<br />the work.</h1><p class="lead">Product thinking is most useful when it explains a decision. These essays start with the constraints I have encountered in enterprise software.</p></header><div class="writing-list">{articles.map(a=><article><p class="eyebrow">{a.data.topic}</p><h2><a href={'/writing/'+a.id+'/'}>{a.data.title}</a></h2><p>{a.data.description}</p><a class="text-link" href={'/writing/'+a.id+'/'}>Read the essay <Arrow/></a></article>)}</div></div>
</BaseLayout>
