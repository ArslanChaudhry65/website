---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseDiagram from '../../components/CaseDiagram.astro';
import Arrow from '../../components/Arrow.astro';
export async function getStaticPaths() {
 const entries = await getCollection('work');
 return entries.map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const work = (await getCollection('work')).sort((a,b)=>a.data.order-b.data.order);
const next = work[(work.findIndex(w=>w.id===entry.id)+1)%work.length];
const words = entry.body?.split(/\s+/).length || 0;
---
<BaseLayout title={entry.data.title} description={entry.data.description} section="Work" type="article" ogImage={entry.data.diagram}>
  <div class="shell">
    <header class="case-heading"><a class="back-link" href="/work/">All selected work</a><p class="eyebrow">{entry.data.number} / {entry.data.kind} / {entry.data.category}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><dl class="case-meta"><div><dt>Role</dt><dd>{entry.data.role}</dd></div><div><dt>Period</dt><dd>{entry.data.period}</dd></div><div><dt>Status</dt><dd>{entry.data.status}</dd></div><div><dt>Reading time</dt><dd>{Math.max(1,Math.ceil(words/200))} min</dd></div></dl></header>
    <div class="case-summary"><div><p class="eyebrow">My contribution</p><p>{entry.data.decision}</p></div><div><p class="eyebrow">What the evidence shows</p><p>{entry.data.result}</p></div></div>
    <CaseDiagram kind={entry.data.diagram} />
    <div class="reading-layout">
      <aside class="contents"><nav aria-label="On this page"><p class="eyebrow">In this case</p><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></nav></aside>
      <article class="prose"><Content /></article>
    </div>
    <div class="next-read"><p class="eyebrow">Next / {next.data.kind}</p><h2><a href={'/work/'+next.id+'/'}>{next.data.title} <Arrow /></a></h2></div>
  </div>
</BaseLayout>
