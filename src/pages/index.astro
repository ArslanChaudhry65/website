---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import Arrow from '../components/Arrow.astro';
const work = (await getCollection('work')).sort((a,b)=>a.data.order-b.data.order);
const articles = (await getCollection('writing')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout>
  <div class="shell">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-main">
        <p class="eyebrow">Product Owner / Enterprise software &amp; AI</p>
        <h1 id="hero-heading">I make high-consequence product decisions in <span>complex B2B software.</span></h1>
        <p class="hero-description">Scaling enrolment. Migrating a platform without a cutover day. Designing an AI beta that can inform a price. I work where customer needs meet the constraints of a real system.</p>
        <div class="actions"><a class="button button-primary" href="#selected-work">View selected work <Arrow /></a><a class="text-link" href="/contact/">Get in touch <Arrow direction="up" /></a></div>
      </div>
      <aside class="hero-aside" aria-label="Current work">
        <span class="index-label">Currently</span>
        <p class="current-role">Product Owner<br />Scheer IMC</p>
        <p>Two teams. One enterprise learning platform.</p>
        <div class="aside-item"><span class="eyebrow">Platform</span><p>Modernisation, scale and the cost of changing a mature product.</p></div>
        <div class="aside-item"><span class="eyebrow">AI</span><p>Learner assistance, permissions and product economics.</p></div>
        <a class="text-link small" href="/about/">About my work <Arrow /></a>
      </aside>
    </section>
    <div class="scope-strip" aria-label="Areas of work"><span>Enterprise scale</span><span>Reversible migration</span><span>AI product economics</span></div>
    <section class="section" id="selected-work" aria-labelledby="work-heading">
      <div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2 id="work-heading">Decisions, with consequences.</h2></div><p>Two case studies and a current product bet. Each names the choice, the trade-off and the limits of the evidence.</p></div>
      {work.map(item => <WorkCard item={item} />)}
    </section>
    <section class="section perspective" aria-labelledby="perspective-heading">
      <div><p class="eyebrow">02 / Perspective</p><h2 id="perspective-heading">The constraint is part of the product.</h2><p class="section-intro">I read the code path before I write the requirement. Understanding where a system fails changes which product decision is worth making.</p><a class="text-link" href="/writing/">Read my writing <Arrow /></a></div>
      <ol class="principles">
        <li><span class="eyebrow">01</span><div><h3>Find the expensive assumption.</h3><p>A repeated per-user operation can look like a slow feature. At enterprise scale, it becomes a different problem.</p></div></li>
        <li><span class="eyebrow">02</span><div><h3>Make change reversible.</h3><p>Customers bring different configurations, dependencies and timelines. A migration has to account for them.</p></div></li>
        <li><span class="eyebrow">03</span><div><h3>Measure the next decision.</h3><p>An AI beta should help decide what to ship, what it costs and what a customer could reasonably buy.</p></div></li>
      </ol>
    </section>
    <section class="section" aria-labelledby="writing-heading">
      <div class="section-heading"><div><p class="eyebrow">03 / Writing</p><h2 id="writing-heading">Notes from the work.</h2></div><p>Practical arguments drawn from the decisions above.</p></div>
      <div class="article-grid">{articles.map(article => <article class="article-card"><p class="eyebrow">{article.data.topic}</p><h3><a href={'/writing/' + article.id + '/'}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="text-link" href={'/writing/' + article.id + '/'}>Read the essay <Arrow /></a></article>)}</div>
    </section>
    <section class="section about-summary" aria-labelledby="about-heading">
      <div><p class="eyebrow">04 / Background</p><h2 id="about-heading">Close to the system.<br />Accountable for the product.</h2></div>
      <div><p>I am a Product Owner at Scheer IMC, working on the imc Learning Suite across platform modernisation and learner-facing AI. Previously, I worked as a Product Owner at PwC.</p><p>I am interested in senior product roles where understanding the product means understanding its customers, its economics and the system underneath. My focus is B2B SaaS, with remote and Berlin-based opportunities.</p><div class="actions"><a class="text-link" href="/about/">About &amp; experience <Arrow /></a><a class="text-link" href="/cv/arslan-chaudhry.pdf">View CV <Arrow direction="up" /></a></div></div>
    </section>
  </div>
</BaseLayout>
